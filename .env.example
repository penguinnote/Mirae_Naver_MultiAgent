# .env.example  →  복사해서 .env 로 쓰세요 (.env는 절대 깃에 올리지 마세요)
#
#   cp .env.example .env
#
# 값은 따옴표 없이, = 뒤에 공백 없이 붙여 씁니다.


# ─────────────────────────────────────────────────────────────
# 1) CLOVA OCR — 스캔 PDF 텍스트 추출 (build_dataset.py)
# ─────────────────────────────────────────────────────────────
# 네이버 클라우드 콘솔 > CLOVA OCR > 도메인 > 옵션 > "API Gateway 연동"
# 여기서 Invoke URL과 Secret Key를 확인/발급합니다.
#
# ⚠️ extract_test.py에 하드코딩돼 있던 키는 이미 노출된 상태입니다.
#    반드시 Secret Key를 재발급받아 쓰세요.
#
# 비워두면 OCR 없이 텍스트 레이어만 추출합니다 (스캔 PDF는 건너뜀).

CLOVA_OCR_URL=
CLOVA_OCR_SECRET=


# ─────────────────────────────────────────────────────────────
# 2) CLOVA Studio — 임베딩 (embed_and_index.py, search.py)
# ─────────────────────────────────────────────────────────────
# OCR과는 완전히 다른 서비스이고, 키도 별개입니다.
# 네이버 클라우드 콘솔 > CLOVA Studio 로 들어가서 API 키를 발급받으세요.
# (콘솔 UI에 따라 '테스트 앱 / 서비스 앱' 형태로 발급되기도 합니다)
#
# 값을 넣은 뒤 반드시 아래를 먼저 실행해 응답 구조를 확인하세요.
#     python embed_and_index.py --selftest

CLOVA_API_KEY=

# 엔드포인트. 콘솔에 안내된 URL과 다르면 콘솔 쪽을 따르세요.
CLOVA_EMBED_URL=https://clovastudio.stream.ntruss.com/v1/api-tools/embedding/v2

# 서비스 앱 식별자.
# 콘솔 > 서비스 앱 신청 > (임베딩 v2 행) 코드 보기 에 표시되는
#   X-NCP-CLOVASTUDIO-REQUEST-ID: <이 값>
# 을 그대로 넣으세요. 비워두면 테스트 앱 한도로 처리될 수 있습니다.
CLOVA_EMBED_REQUEST_ID=

# 인증 헤더 방식: bearer | ncp
#   bearer → Authorization: Bearer <CLOVA_API_KEY>
#   ncp    → X-NCP-CLOVASTUDIO-API-KEY: <CLOVA_API_KEY>
#            (+ X-NCP-APIGW-API-KEY: <CLOVA_APIGW_KEY>)
# bearer로 401/403이 나면 ncp로 바꿔 다시 --selftest 해보세요.
CLOVA_EMBED_AUTH=bearer

CLOVA_APIGW_KEY=

# ─────────────────────────────────────────────────────────────
# 3) CLOVA Studio — HCX-007 답변 생성 · 리랭커 (agent.py, search.py)
# ─────────────────────────────────────────────────────────────
# API 키는 위 CLOVA_API_KEY 를 그대로 씁니다. 다만 서비스 앱 식별자
# (X-NCP-CLOVASTUDIO-REQUEST-ID)는 임베딩 / 리랭커 / HCX-007 이 각각
# 다른 값입니다. 섞어 쓰면 엉뚱한 서비스 앱 한도로 처리됩니다.
#
# 콘솔 > 서비스 앱 신청 > 해당 모델 행 > 코드 보기 에 표시되는
#   X-NCP-CLOVASTUDIO-REQUEST-ID: <이 값>
# 을 각각 그대로 넣으세요.
#
# ⚠️ 배포 시 이 두 값이 비어 있으면 답변 생성과 리랭킹이 테스트 앱 한도로
#    처리됩니다. 서버에는 .env.example 로 새로 만들지 말고 로컬 .env 를
#    scp 로 그대로 복사하세요. (deploy/DEPLOY.md 2절 참조)

CLOVA_CHAT_REQUEST_ID=

CLOVA_RERANK_REQUEST_ID=


# 아래 3개는 .env 에 없어도 됩니다 — agent.py 에 기본값이 있습니다.
# 규격이 바뀌었을 때만 덮어쓰세요.
#
#   CLOVA_CHAT_URL=
#   CLOVA_RERANK_URL=
#
# HCX-007 은 추론 모델이라 body 규격이 다릅니다. maxTokens 를 보내면
# 40001 Invalid parameter 가 납니다. 정답 조합:
#   maxCompletionTokens + thinking: {"effort": "none"}
#
#   CLOVA_CHAT_PROFILE=maxCompletionTokens+thinking
