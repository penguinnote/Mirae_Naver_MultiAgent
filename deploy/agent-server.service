# 연금 Agent 평가 API — systemd 서비스 유닛
#
# 설치 (NCP 서버에서, 이 저장소를 /opt/pension-agent 등에 clone했다고 가정):
#   1) 아래 WorkingDirectory / ExecStart의 경로를 실제 배포 경로로 바꾼다.
#   2) sudo cp deploy/agent-server.service /etc/systemd/system/agent-server.service
#   3) sudo systemctl daemon-reload
#   4) sudo systemctl enable --now agent-server
#   5) sudo systemctl status agent-server
#   6) journalctl -u agent-server -f     ← 로그 확인 (server.py의 print는 stderr로 감)
#
# .env는 별도로 EnvironmentFile에 넣지 않는다 — agent.py가 모듈 임포트 시점에
# python-dotenv로 WorkingDirectory 기준 .env를 직접 읽는다 (CLAUDE.md 5장 참고).
# 그러니 .env 파일이 WorkingDirectory에 반드시 있어야 한다.
#
# Restart=always — 평가 기간(09.07~09.20 중 배정된 1주) 동안 무중단 운영이
# 요구사항이라, 프로세스가 죽어도 systemd가 즉시 재기동한다.

[Unit]
Description=연금 Agent 평가 API (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/pension-agent
ExecStart=/opt/pension-agent/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3
# 평가 데드라인(240초)+마진보다 넉넉하게 종료 유예를 준다.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
